# ---- Backend environment (set these in Render's dashboard in production; in backend/.env locally). NEVER commit real values.
ENV=production                      # production disables AUTH_DISABLED automatically

# Supabase (Dashboard -> Project Settings -> API / Database)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=                  # publishable/anon key (used to ask Supabase to validate user tokens)
SUPABASE_SERVICE_ROLE_KEY=          # BACKEND ONLY. Used solely for private Storage uploads/downloads. Never in the frontend.
SUPABASE_JWT_SECRET=                # optional: only for legacy HS256 projects (enables offline token verification)
SUPABASE_BUCKET=papers
DATABASE_URL=postgresql+psycopg://postgres.YOUR-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Generative AI - hosted FREE tiers only. Keys: console.groq.com/keys  and  aistudio.google.com/apikey
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b      # verify it is available on your free tier: console.groq.com/docs/models
GEMINI_API_KEY=                     # create it in a Google AI Studio project WITHOUT billing enabled (keeps usage free)
GEMINI_MODEL=gemini-2.5-flash       # verify: ai.google.dev/gemini-api/docs/models
AI_PRIMARY_PROVIDER=                # empty = per-feature routing table (docs/AI_ROUTING.md); or groq / gemini to force one
AI_FALLBACK_ENABLED=true
AI_TIMEOUT=60
AI_MAX_RETRIES=1
# Optional per-feature model override, e.g. GROQ_MODEL_MENTOR=openai/gpt-oss-20b  /  GEMINI_MODEL_EXTRACTION=gemini-2.5-flash-lite
# Local free-quota guards (0 disables). Set slightly BELOW the limits shown in your own consoles:
GROQ_RPM=25
GROQ_RPD=900
GROQ_TPM=6000
GROQ_TPD=150000
GEMINI_RPM=8
GEMINI_RPD=200
GEMINI_TPM=200000
GEMINI_TPD=0

# Embeddings (separate from generation) - all 768-dimensional
EMBED_PROVIDER=gemini               # gemini | local (needs requirements-local-embeddings.txt) | hash (tests only)
EMBED_MODEL=gemini-embedding-001

CORS_ORIGINS=https://YOUR-APP.vercel.app,http://localhost:5173

# Local development without Supabase (single built-in user, SQLite, local PDF folder). Ignored when ENV=production.
# AUTH_DISABLED=true
# STORAGE_BACKEND=local
